<?xml version="1.0" encoding="UTF-8"?>
<!--
  tessera-otp · passwordless one-time-code authenticator for Keycloak
  SPDX-FileCopyrightText: 2026 Losol AS
  SPDX-License-Identifier: MPL-2.0
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>no.losol.keycloak</groupId>
    <artifactId>keycloak-tessera-otp</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Keycloak Tessera OTP Authenticator</name>
    <description>Passwordless one-time-code authenticator for Keycloak</description>

    <licenses>
        <license>
            <name>MPL-2.0</name>
            <url>https://www.mozilla.org/en-US/MPL/2.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <keycloak.version>26.6.4</keycloak.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-core</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi-private</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-services</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ALTCHA proof-of-work captcha for the email-OTP send step.
             Keycloak loads each provider JAR with its own classloader and does
             not export altcha (or, on the runtime classpath, org.json) to it, so
             both must be SHADED into this JAR (see maven-shade-plugin below) or
             the classes are not found at runtime. -->
        <dependency>
            <groupId>org.altcha</groupId>
            <artifactId>altcha</artifactId>
            <version>2.0.2</version>
            <scope>compile</scope>
        </dependency>
        <!-- altcha calls the org.json API (declared "provided" in its POM), and
             Keycloak does not export org.json to provider classloaders, so we
             supply and shade it ourselves. We use android-json — a clean-room,
             Apache-2.0 reimplementation of the same org.json.* classes — INSTEAD
             of the reference org.json:json, whose "JSON License" carries a
             non-free "Good, not Evil" clause. Same package/classes, so altcha is
             none the wiser; it just keeps the distribution license-clean. -->
        <dependency>
            <groupId>com.vaadin.external.google</groupId>
            <artifactId>android-json</artifactId>
            <version>0.0.20131108.vaadin1</version>
            <scope>compile</scope>
        </dependency>

        <!-- Test only. AltchaAndroidJsonTest round-trips a challenge through
             altcha to prove android-json satisfies the org.json API it calls. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <!-- Run the JUnit 5 tests (older surefire defaults predate JUnit 5). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>

            <!-- Shade altcha (+ the android-json org.json impl) into the provider
                 JAR. Without this, Keycloak's per-provider classloader cannot see
                 these classes at runtime. Packages are NOT relocated: altcha
                 references org.json by its real package name, so the classes must
                 keep their original coordinates inside the shaded JAR. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Replace the thin JAR with the shaded one so the
                                 Dockerfile's keycloak-tessera-otp-*.jar copy
                                 picks up the version that contains altcha. -->
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.altcha:altcha</include>
                                    <include>com.vaadin.external.google:android-json</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
